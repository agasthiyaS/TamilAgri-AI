# ============================================================
# TamilAgri AI - Environment Configuration (.env.example)
# Copy this file to .env and adjust values if needed.
# By default, TamilAgri AI runs in DEMO mode with ZERO API keys!
# ============================================================

# App Mode (true = simulation mode with mock weather & simulated SMS)
DEMO_MODE=true

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Default: SQLite for zero-setup local storage)
DATABASE_URL=sqlite:///./tamilagri.db

# Weather Provider: "demo" (built-in realistic TN data) or "open_meteo" (free real forecasts)
WEATHER_PROVIDER=demo

# SMS Provider: "demo" (simulated logging) or "twilio" or "generic_webhook"
SMS_PROVIDER=demo

# Optional Twilio Credentials (only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Webhook URL (only if SMS_PROVIDER=generic_webhook)
SMS_WEBHOOK_URL=
